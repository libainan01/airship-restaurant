{
  "name": "@airship-restaurant/content",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "node ../../scripts/content-tool.mjs check && node ../../scripts/dialogue-content-tool.mjs check",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "node ../../scripts/content-tool.mjs check && node ../../scripts/dialogue-content-tool.mjs check",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
