  "recipes": [
    {
      "id": "recipe.tomato_scrambled_egg",
      "version": 1,
      "name": "番茄炒蛋",
      "durationMs": 51000,
      "outputItemId": "dish.tomato_scrambled_egg",
      "outputQuantity": 1,
      "unitPriceCopper": 30,
      "ingredients": [
        { "itemId": "ingredient.egg", "quantity": 2 },
        { "itemId": "ingredient.tomato", "quantity": 3 }
      ],
      "productionSteps": [
        { "id": "step.process_tomato", "name": "处理西红柿", "durationMs": 8000, "stationTags": ["station.prep"], "attendance": "required", "prerequisiteStepIds": [] },
        { "id": "step.whisk_egg", "name": "打散鸡蛋", "durationMs": 7000, "stationTags": ["station.prep"], "attendance": "required", "prerequisiteStepIds": [] },
        { "id": "step.fry_tomato", "name": "炒西红柿", "durationMs": 12000, "stationTags": ["station.pan_fry"], "attendance": "required", "prerequisiteStepIds": ["step.process_tomato"] },
        { "id": "step.fry_egg", "name": "炒鸡蛋", "durationMs": 10000, "stationTags": ["station.pan_fry"], "attendance": "required", "prerequisiteStepIds": ["step.whisk_egg"] },
        { "id": "step.combine", "name": "合炒", "durationMs": 9000, "stationTags": ["station.pan_fry"], "attendance": "required", "prerequisiteStepIds": ["step.fry_tomato", "step.fry_egg"] },
        { "id": "step.plate", "name": "装盘", "durationMs": 5000, "stationTags": ["station.plating"], "attendance": "required", "prerequisiteStepIds": ["step.combine"] }
      ],
      "detailedRecipe": {
        "realWorldName": "家常番茄炒鸡蛋",
        "servings": 2,
        "ingredients": [
          { "name": "番茄", "amount": "300 克（约 2 个中等大小）" },
          { "name": "鸡蛋", "amount": "3 个" },
          { "name": "食用油", "amount": "20 毫升" },
          { "name": "盐", "amount": "2 克" },
          { "name": "白砂糖", "amount": "3 克，可选" },
          { "name": "葱花", "amount": "5 克，可选" }
        ],
        "steps": [
          { "order": 1, "instruction": "番茄洗净去蒂，切成约 2 厘米的小块；鸡蛋打入碗中，加入约 1 克盐并充分搅散。" },
          { "order": 2, "instruction": "炒锅以中大火烧热，加入约 10 毫升油；倒入蛋液，快速推炒至七八成熟、表面仍略湿润时立即盛出。" },
          { "order": 3, "instruction": "锅中加入剩余油，倒入番茄，以中火翻炒 2 至 3 分钟，直至番茄变软并析出汤汁。" },
          { "order": 4, "instruction": "加入剩余盐和可选的白砂糖调味，将炒好的鸡蛋倒回锅中，以大火翻炒 30 至 60 秒，使鸡蛋裹上番茄汁。" },
          { "order": 5, "instruction": "关火后撒上可选的葱花，趁热装盘食用。" }
        ],
        "notes": [
          "鸡蛋第一次下锅不要炒至全干，回锅后口感更嫩。",
          "番茄酸甜度不同，可先尝味再决定是否加糖。",
          "鸡蛋应加热至完全凝固；接触生蛋液的餐具需及时清洗。"
        ]
      }
    },
    {
      "id": "recipe.hearth_flatbread",
      "version": 1,
      "name": "炉火云麦饼",
      "durationMs": 45000,
      "outputItemId": "dish.hearth_flatbread",
      "outputQuantity": 2,
      "unitPriceCopper": 4,
      "ingredients": [
        {
          "itemId": "ingredient.cloud_wheat",
          "quantity": 2
        },
        {
          "itemId": "ingredient.kettle_milk",
          "quantity": 1
        }
      ],
      "productionSteps": [
        {
          "id": "step.mix_and_pan_fry",
          "name": "和面并煎制",
          "durationMs": 45000,
          "stationTags": [
            "station.pan_fry"
          ],
          "attendance": "required",
          "prerequisiteStepIds": []
        }
      ],
      "detailedRecipe": {
        "realWorldName": "牛奶软饼",
        "servings": 2,
        "ingredients": [
          {
            "name": "中筋面粉",
            "amount": "100 克"
          },
          {
            "name": "牛奶",
            "amount": "150 毫升"
          },
          {
            "name": "鸡蛋",
            "amount": "1 个"
          },
          {
            "name": "盐",
            "amount": "1 克"
          },
          {
            "name": "食用油",
            "amount": "适量"
          }
        ],
        "steps": [
          {
            "order": 1,
            "instruction": "面粉、盐、鸡蛋与牛奶搅拌至没有干粉，静置 10 分钟。"
          },
          {
            "order": 2,
            "instruction": "平底锅薄薄刷油，以中小火将面糊两面煎至金黄。"
          }
        ],
        "notes": [
          "面糊应能缓慢流动；过稠时可少量补牛奶。"
        ]
      }
    },
