      ],
      "detailedRecipe": {
        "realWorldName": "胡萝卜奶油浓汤",
        "servings": 3,
        "ingredients": [
          {
            "name": "胡萝卜",
            "amount": "300 克"
          },
          {
            "name": "洋葱",
            "amount": "100 克"
          },
          {
            "name": "牛奶",
            "amount": "250 毫升"
          },
          {
            "name": "清水",
            "amount": "300 毫升"
          },
          {
            "name": "黄油",
            "amount": "15 克"
          },
          {
            "name": "盐与黑胡椒",
            "amount": "适量"
          }
        ],
        "steps": [
          {
            "order": 1,
            "instruction": "胡萝卜与洋葱切小块，用黄油小火炒至洋葱透明。"
          },
          {
            "order": 2,
            "instruction": "加清水煮至胡萝卜软烂，打成细腻泥状。"
          },
          {
            "order": 3,
            "instruction": "加入牛奶，小火加热并以盐、黑胡椒调味，不要沸腾。"
          }
        ],
        "notes": [
          "没有料理机时可延长炖煮并用压泥器处理。"
        ]
      }
    },
