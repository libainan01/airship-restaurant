      "detailedRecipe": {
        "realWorldName": "烟熏牛肉蔬菜炖菜",
        "servings": 4,
        "ingredients": [
          {
            "name": "牛肉",
            "amount": "500 克"
          },
          {
            "name": "胡萝卜",
            "amount": "2 根"
          },
          {
            "name": "土豆",
            "amount": "2 个"
          },
          {
            "name": "洋葱",
            "amount": "1 个"
          },
          {
            "name": "烟熏培根",
            "amount": "80 克"
          },
          {
            "name": "番茄膏",
            "amount": "1 汤匙"
          },
          {
            "name": "清水或高汤",
            "amount": "800 毫升"
          },
          {
            "name": "盐、黑胡椒与月桂叶",
            "amount": "适量"
          }
        ],
        "steps": [
          {
            "order": 1,
            "instruction": "牛肉切块擦干，分批煎至表面上色后盛出。"
          },
          {
            "order": 2,
            "instruction": "原锅炒香培根、洋葱与番茄膏，加入牛肉和高汤。"
          },
          {
            "order": 3,
            "instruction": "加月桂叶，小火炖约 60 分钟，再加入胡萝卜和土豆炖至软烂。"
          },
          {
            "order": 4,
            "instruction": "以盐和黑胡椒调味，静置 5 分钟后盛出。"
          }
        ],
        "notes": [
          "牛肉分批煎制可避免锅温骤降。",
          "现实制作时间约 90 分钟；游戏时长为节奏化数值。"
        ]
      }
