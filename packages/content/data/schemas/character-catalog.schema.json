{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airship-restaurant.local/schemas/character-catalog.schema.json",
  "title": "character-catalog",
  "type": "object",
  "required": [
    "schemaVersion",
    "characters",
    "customers",
    "localizations",
    "talents",
    "recruitment"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "characters": {
      "type": "array"
    },
    "customers": {
      "type": "array"
    },
    "talents": {
      "type": "array"
    },
    "recruitment": {
      "type": "object"
    },
    "localizations": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    }
  },
  "additionalProperties": false
}
