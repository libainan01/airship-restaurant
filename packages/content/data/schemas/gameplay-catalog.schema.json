{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airship-restaurant.local/schemas/gameplay-catalog.schema.json",
  "title": "gameplay-catalog",
  "type": "object",
  "required": [
    "schemaVersion",
    "recipes",
    "supplyBundles",
    "initialIngredientMultiplier"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "recipes": {
      "type": "array"
    },
    "supplyBundles": {
      "type": "array"
    },
    "initialIngredientMultiplier": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "additionalProperties": false
}
