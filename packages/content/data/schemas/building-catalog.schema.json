{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airship-restaurant.local/schemas/building-catalog.schema.json",
  "title": "building-catalog",
  "type": "object",
  "required": [
    "schemaVersion",
    "buildings"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "buildings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/building"
      }
    }
  },
  "$defs": {
    "footprint": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "componentSlot": {
      "type": "object",
      "required": [
        "slotId",
        "capabilityId"
      ],
      "properties": {
        "slotId": {
          "type": "string",
          "pattern": "^slot\\.[a-z][a-z0-9_]*$"
        },
        "capabilityId": {
          "type": "string",
          "pattern": "^capability\\.[a-z][a-z0-9_]*$"
        }
      },
      "additionalProperties": false
    },
    "level": {
      "type": "object",
      "required": [
        "level",
        "upgradeCostCopper",
        "footprint",
        "maxDurability",
        "capabilityValues"
      ],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1
        },
        "upgradeCostCopper": {
          "type": "integer",
          "minimum": 0
        },
        "footprint": {
          "$ref": "#/$defs/footprint"
        },
        "maxDurability": {
          "type": "integer",
          "minimum": 1
        },
        "capabilityValues": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false
    },
    "building": {
      "type": "object",
      "required": [
        "id",
        "name",
        "buildCostCopper",
        "styleIds",
        "defaultStyleId",
        "necessary",
        "movable",
        "storable",
        "removable",
        "footprint",
        "capabilityIds",
        "placementZoneTags",
        "componentSlots",
        "levels"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^building\\.[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "footprint": {
          "$ref": "#/$defs/footprint"
        },
        "capabilityIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^capability\\.[a-z][a-z0-9_]*$"
          }
        },
        "placementZoneTags": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^zone\\.[a-z][a-z0-9_]*$"
          }
        },
        "componentSlots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/componentSlot"
          }
        },
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/level"
          }
        },
        "buildCostCopper": {
          "type": "integer",
          "minimum": 1
        },
        "styleIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          }
        },
        "defaultStyleId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "necessary": {
          "type": "boolean"
        },
        "movable": {
          "type": "boolean"
        },
        "storable": {
          "type": "boolean"
        },
        "removable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}