{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airship-restaurant.local/dialogue-chapter.schema.json",
  "title": "空艇餐厅章节对白",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "chapterId",
    "title",
    "locationId",
    "defaults",
    "ambientDialogues",
    "storyDialogues"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "chapterId": {
      "type": "string",
      "pattern": "^chapter\\.[a-z0-9_.]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "locationId": {
      "type": "string",
      "pattern": "^location\\.[a-z0-9_]+$"
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineDurationMs",
        "ambientWeight",
        "ambientCooldownMs",
        "ambientMaxPlaysPerSession"
      ],
      "properties": {
        "lineDurationMs": {
          "type": "integer",
          "minimum": 1
        },
        "ambientWeight": {
          "type": "integer",
          "minimum": 1
        },
        "ambientCooldownMs": {
          "type": "integer",
          "minimum": 0
        },
        "ambientMaxPlaysPerSession": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ambientDialogues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ambientDialogue"
      }
    },
    "storyDialogues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/storyDialogue"
      }
    }
  },
  "$defs": {
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speakerId",
        "text"
      ],
      "properties": {
        "speakerId": {
          "type": "string",
          "pattern": "^speaker\\.[a-z0-9_]+$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ambientDialogue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contexts",
        "minimumFamiliarity",
        "lines"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^dialogue\\.ambient\\.[a-z0-9_]+$"
        },
        "contexts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "arrival",
              "waiting",
              "eating",
              "departing",
              "idle"
            ]
          }
        },
        "minimumFamiliarity": {
          "enum": [
            "new",
            "returning",
            "regular"
          ]
        },
        "prerequisiteEventIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^story\\.[a-z0-9_]+$"
          }
        },
        "weight": {
          "type": "integer",
          "minimum": 1
        },
        "cooldownMs": {
          "type": "integer",
          "minimum": 0
        },
        "maxPlaysPerSession": {
          "type": "integer",
          "minimum": 1
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/line"
          }
        }
      }
    },
    "storyDialogue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "lines"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^dialogue\\.story\\.[a-z0-9_]+$"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/line"
          }
        }
      }
    }
  }
}
