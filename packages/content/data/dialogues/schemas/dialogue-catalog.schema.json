{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airship-restaurant.local/dialogue-catalog.schema.json",
  "title": "空艇餐厅对白目录",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "locations",
    "speakers"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^location\\.[a-z0-9_]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "speakers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "characterId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^speaker\\.[a-z0-9_]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "characterId": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^character\\.[a-z0-9_]+$"
          }
        }
      }
    }
  }
}
