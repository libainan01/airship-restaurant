  "localizations": {
    "localization.story.bell_stew_first_service.body": "玛莎想要的原本只是一顿安稳的热饭。后来，托马斯把这顿饭做了很多年。",
    "localization.journal.bell_hearth_stew.discovery": "玛莎与托马斯正在等两份记忆里的炖菜。愿望已经重新写进锅边的旧笔记。",
    "localization.journal.bell_hearth_stew.summary": "玛莎想要的原本只是一顿安稳的热饭。后来，托马斯把这顿饭做了很多年。",
    "localization.story_profile.martha_bell.identity": "贝尔家的旧友。她记得战时炉火旁那锅让人安心的炖菜。",
    "localization.story_profile.thomas_bell.identity": "玛莎的家人。多年里，他一直在替那顿没能按时上桌的热饭续火。",
    "localization.story_node.martha_bell.first_service.hint": "也许一道记忆里的炖菜，能让她愿意谈起过去。",
    "localization.story_node.martha_bell.first_service.summary": "玛莎终于吃到了记忆里的炉火炖菜，也说出了那段被战争打断的心愿。",
    "localization.story_node.thomas_bell.first_service.hint": "先让贝尔一家在这里安心吃完一顿饭。",
    "localization.story_node.thomas_bell.first_service.summary": "托马斯守了很多年的炉火，在这顿饭里终于有了回音。"
  },
