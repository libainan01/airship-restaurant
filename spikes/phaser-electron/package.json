{
  "name": "airship-restaurant-desktop-presence-spike",
  "version": "0.1.0",
  "private": true,
  "description": "Phaser + Electron technical spike for a transparent desktop companion.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "check": "npm run test && npm run build",
    "smoke": "npm run build && electron . --smoke-test"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "concurrently": "10.0.4",
    "electron": "43.2.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wait-on": "9.1.0"
  }
}
