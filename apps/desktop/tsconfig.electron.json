{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ],
    "rootDir": "src",
